{
  "name": "migeanje-store-api",
  "version": "0.0.1",
  "private": true,
  "description": "Migeanje Store commerce backend: Medusa v2 with custom modules.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "medusa build",
    "start": "medusa start",
    "dev": "medusa develop",
    "lint": "biome check . && medusa lint",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run test:unit && pnpm run test:integration:modules && pnpm run test:integration:http",
    "test:integration:http": "TEST_TYPE=integration:http NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit",
    "test:integration:modules": "TEST_TYPE=integration:modules NODE_OPTIONS=--experimental-vm-modules jest --silent=false --runInBand --forceExit --passWithNoTests",
    "test:unit": "TEST_TYPE=unit NODE_OPTIONS=--experimental-vm-modules jest --silent --runInBand --forceExit --passWithNoTests"
  },
  "dependencies": {
    "@medusajs/admin-sdk": "2.22.7",
    "@medusajs/admin-shared": "2.22.7",
    "@medusajs/caching": "2.22.7",
    "@medusajs/cli": "2.22.7",
    "@medusajs/dashboard": "2.22.7",
    "@medusajs/draft-order": "2.22.7",
    "@medusajs/framework": "2.22.7",
    "@medusajs/medusa": "2.22.7",
    "@medusajs/ui": "4.2.9",
    "@tanstack/react-query": "5.64.2",
    "react-i18next": "13.5.0",
    "react-router-dom": "7.18.2",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@medusajs/eslint-plugin": "2.22.7",
    "@medusajs/test-utils": "2.22.7",
    "@swc/core": "^1.7.28",
    "@swc/jest": "^0.2.36",
    "@types/jest": "^29.5.13",
    "@types/node": "^20.12.11",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "eslint": "^9.39.4",
    "jest": "^29.7.0",
    "jiti": "^2.7.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2",
    "vite": "^7.3.7"
  }
}
